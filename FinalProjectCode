#include <Arduino.h>
#include <IRremote.hpp>
#include <LiquidCrystal.h>

// 
//Port and Register stuff for the circuit and arduino locatoins 
#define FAN_DDR   DDRH
#define FAN_port  PORTH
#define FAN_num   PH6

#define SENSOR_DDR   DDRF
#define SENSOR_port  PORTF
#define SENSOR_pin   PINF
#define SENSOR_num   PF0

#define DHT_ANApin A0 //temperature sensor location(analog)

const int IR_dp = 6;
const int FAN_PIN = 9;

LiquidCrystal lcd(12, 11, 5, 4, 3, 2);

// 
// for system states
// 
int UserTemp = 25;
int TempRoom = 0;
bool systemOn = true;

unsigned long lastSensorUpdate = 0;
const unsigned long updateInterval = 2000;

// Using pin 20 as our ISR to interrupt the system// 
volatile bool ISRbut = false;
volatile unsigned long earlyTime = 0;
const unsigned long debLay = 200;

// 
// UART
// 
void uartBegin() {
  uint16_t UARTtime = 8;

  UBRR0H = (UARTtime >> 8);
  UBRR0L = UARTtime;

  UCSR0B = (1 << TXEN0);
  UCSR0C = (1 << UCSZ01) | (1 << UCSZ00);
}

void sendChar(char c) {
  while (!(UCSR0A & (1 << UDRE0)));
  UDR0 = c;
}

void SendSent(const char* text) {
  while (*text) sendChar(*text++);
}

void SendNum(int value) {
  char buffer[10];
  itoa(value, buffer, 10);
  SendSent(buffer);
}

void enter() {
  sendChar('\r');
  sendChar('\n');
}

// 
// Function callsl
// 
void readTemperatureSensor();
void Fan();
void LCDscreen();
void Serialprint();

// 
// ISR (PIN 20 BUTTON)
// 
void ISR_pin20() {
  unsigned long now = millis();

  if (now - earlyTime > debLay) {
    ISRbut = true;
    earlyTime = now;
  }
}


// 
void setup() {

  uartBegin(); // start with UARt first

  FAN_DDR |= (1 << FAN_num);
  FAN_port &= ~(1 << FAN_num);

  IrReceiver.begin(IR_dp, ENABLE_LED_FEEDBACK);

  lcd.begin(16, 2);

  pinMode(20, INPUT_PULLUP);

  
  attachInterrupt(digitalPinToInterrupt(20), ISR_pin20, FALLING);

  lcd.print("Starting system");
  SendSent("System is starting...\r\n");

  delay(1000);
  lcd.clear();
}


void loop() {

  // 
  // ISR button pressing. Trying to get it to interrupt and save the information we are using at the time of reset.
  // 
  if (ISRbut) {
    ISRbut = false;

    SendSent("Button ISR triggered (PIN 20)\r\n");
    enter();

    systemOn = !systemOn;

    if (!systemOn) {
      FAN_port &= ~(1 << FAN_num);
      SendSent("System turned OFF via button\r\n");
    } else {
      SendSent("System turned ON via button\r\n");
    }

    LCDscreen();
  }

  // 
  // IR remote stuffy trying to get it to workl
  // 
  if (IrReceiver.decode()) {

    uint16_t code = IrReceiver.decodedIRData.command;

    SendSent("Remote input received: ");
    SendNum(code);
    enter();

    if (code == 0x45) {
      systemOn = !systemOn;

      if (!systemOn) {
        FAN_port &= ~(1 << FAN_num);
        SendSent("System turned OFF\r\n");
      } else {
        SendSent("System turned ON\r\n");
      }
    }

    if (systemOn) {

      if (code == 0x46) UserTemp++;
      if (code == 0x15) UserTemp--;

      if (code == 0x47) {
        UserTemp = 25;
        lcd.clear();
        lcd.print("Resetting...");
        SendSent("Target temperature reset\r\n");
        delay(500);
      }
    }

    LCDscreen();
    IrReceiver.resume();
  }

  // 
  // Sensors updating temperature data and other variables/devices
  // 
  if (systemOn && millis() - lastSensorUpdate > updateInterval) {

    readTemperatureSensor();
    Fan();
    LCDscreen();
    Serialprint();

    lastSensorUpdate = millis();
  }

  if (!systemOn && millis() - lastSensorUpdate > updateInterval) {

    LCDscreen();
    Serialprint();

    lastSensorUpdate = millis();
  }
}

// 
// Temperature sensor is buggy trying to fix with port manipulation
 
void readTemperatureSensor() {

  byte data[5] = {0};

  SENSOR_DDR |= (1 << SENSOR_num);
  SENSOR_port &= ~(1 << SENSOR_num);
  delay(18);

  SENSOR_port |= (1 << SENSOR_num);
  delayMicroseconds(40);

  SENSOR_DDR &= ~(1 << SENSOR_num);

  while (SENSOR_pin & (1 << SENSOR_num));
  while (!(SENSOR_pin & (1 << SENSOR_num)));
  while (SENSOR_pin & (1 << SENSOR_num));

  for (int i = 0; i < 40; i++) {

    while (!(SENSOR_pin & (1 << SENSOR_num)));

    unsigned long start = micros();

    while (SENSOR_pin & (1 << SENSOR_num));

    unsigned long duration = micros() - start;

    data[i / 8] <<= 1;

    if (duration > 40) data[i / 8] |= 1;
  }

  if (data[4] == (data[0] + data[1] + data[2] + data[3])) {
    TempRoom = data[2];
  }
}

// 
// FAN data saving
// 
void Fan() {

  if (TempRoom >= UserTemp) {
    FAN_port |= (1 << FAN_num);
  } else {
    FAN_port &= ~(1 << FAN_num);
  }
}

// 
// LCD
// 
void LCDscreen() {

  lcd.setCursor(0, 0);

  if (!systemOn) {
    lcd.print("System: OFF     ");
    lcd.setCursor(0, 1);
    lcd.print("Press button ON ");
    return;
  }

  lcd.print("Temp: ");
  lcd.print(TempRoom);
  lcd.print((char)223);
  lcd.print("C   ");

  lcd.setCursor(0, 1);

  lcd.print("Target: ");
  lcd.print(UserTemp);
  lcd.print((char)223);
  lcd.print("C ");

  if (PORTH & (1 << FAN_num)) {
    lcd.print("FAN ON ");
  } else {
    lcd.print("FAN OFF");
  }
}

// Messaging the serial monitor our data using our functions.
// 
void Serialprint() {

  SendSent(systemOn ? "ON" : "OFF");
  enter();

  SendSent("Current temp: ");
  SendNum(TempRoom);
  SendSent(" C\r\n");

  SendSent("Target temp: ");
  SendNum(UserTemp);
  SendSent(" C\r\n");

  SendSent("Fan state: ");
  SendSent((PORTH & (1 << FAN_num)) ? "RUNNING" : "STOPPED");
  enter();
}
